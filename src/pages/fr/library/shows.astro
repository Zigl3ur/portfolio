---
import Main from "../../../layouts/Main.astro";
import Show from "../../../components/Show.astro";
import Title from "../../../components/ui/Title.astro";
import shows from "../../../data/shows";
import { getLangFromUrl, translate } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { showLibrary: t } = translate(lang);
---

<Main>
  <div class="pt-12">
    <Title id="shows-library" text={t.title} />
    <p class="text-foreground/70 mb-6">{t.description}</p>
    <div class="flex flex-col gap-8">
      {
        shows.map((show, index) => {
          const isLast = index === shows.length - 1;

          return (
            <>
              <Show showData={show} />
              {!isLast && (
                <span class="border-gray h-px w-28 self-center border-t-2 border-dashed text-center text-5xl font-bold" />
              )}
            </>
          );
        })
      }
    </div>
  </div>
</Main>
